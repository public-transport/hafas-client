chen Fahrpläne werden in den nächsten Wochen vervollständigt.<br><a href=\\\"https://www.vbb.de/zugumzug\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Informationen zu den Bahn-Änderungen zum Fahrplanwechsel</a>\",\"icoX\":5,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221211\",\"sTime\":\"000000\",\"eDate\":\"20230331\",\"eTime\":\"000000\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221103\",\"fTime\":\"195200\",\"tDate\":\"20230331\",\"tTime\":\"000000\"}],\"baseType\":\"GLOBAL\"},{\"hid\":\"181831\",\"act\":true,\"head\":\"Es gilt Maskenpflicht!\",\"text\":\"Bitte tragen Sie eine FFP2-Maske in den Fahrzeugen.<br><a href=\\\"https://www.vbb.de/corona\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Weitere Informationen</a>\",\"icoX\":5,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221116\",\"sTime\":\"072800\",\"eDate\":\"20231209\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221116\",\"fTime\":\"072800\",\"tDate\":\"20231209\",\"tTime\":\"235900\"}],\"baseType\":\"GLOBAL\"}],\"icoL\":[{\"res\":\"loc_stop\"},{\"res\":\"prod_sub_t\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"res\":\"BVG\",\"txt\":\"Berliner Verkehrsbetriebe\"},{\"res\":\"attr_info\"},{\"res\":\"attr_bike_r\"},{\"res\":\"HIM0\"},{\"res\":\"prod_walk\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":115,\"g\":115,\"b\":115}},{\"bg\":{\"r\":0,\"g\":101,\"b\":173},\"shp\":\"C\"},{\"res\":\"cl_pt\"},{\"res\":\"cl_pt_bike\"},{\"res\":\"cl_pt_car\"},{\"res\":\"cl_bike\"},{\"res\":\"cl_car\"},{\"res\":\"cl_foot\"}],\"himMsgCatL\":[{\"id\":0}],\"lDrawStyleL\":[{\"sIcoX\":1,\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"sIcoX\":6,\"type\":\"SOLID\",\"bg\":{\"r\":115,\"g\":115,\"b\":115}},{\"type\":