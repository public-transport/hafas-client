"noopener\\\">Informationen zu den Bahn-Änderungen zum Fahrplanwechsel</a>\",\"icoX\":6,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221211\",\"sTime\":\"000000\",\"eDate\":\"20230331\",\"eTime\":\"000000\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[1],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221103\",\"fTime\":\"195200\",\"tDate\":\"20230331\",\"tTime\":\"000000\"}],\"baseType\":\"GLOBAL\"},{\"hid\":\"181831\",\"act\":true,\"head\":\"Es gilt Maskenpflicht!\",\"text\":\"Bitte tragen Sie eine FFP2-Maske in den Fahrzeugen.<br><a href=\\\"https://www.vbb.de/corona\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Weitere Informationen</a>\",\"icoX\":6,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221116\",\"sTime\":\"072800\",\"eDate\":\"20231209\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[1],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221116\",\"fTime\":\"072800\",\"tDate\":\"20231209\",\"tTime\":\"235900\"}],\"baseType\":\"GLOBAL\"}],\"icoL\":[{\"res\":\"prod_sub_t\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"res\":\"BVG\",\"txt\":\"Berliner Verkehrsbetriebe\"},{\"res\":\"loc_stop\"},{\"res\":\"attr_info\"},{\"res\":\"attr_bike_r\"},{\"res\":\"HIM3\"},{\"res\":\"HIM0\"}],\"himMsgCatL\":[{\"id\":3},{\"id\":0}],\"dirL\":[{\"txt\":\"Osloer Str.\",\"flg\":\"2\"}],\"lDrawStyleL\":[{\"sIcoX\":0,\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}}],\"timeStyleL\":[{\"mode\":\"ABS\"}]},\"journey\":{\"jid\":\"1|45877|0|86|19122022\",\"date\":\"20221219\",\"prodX\":0,\"dirTxt\":\"Osloer Str.\",\"dirFlg\":\"2\",\"status\":\"P\",\"isRchbl\":true,\"stopL\":[{\"locX\":0,\"idx\":0,\"dProdX\":0,\"dPltfS\":{\"type\":\"PL\",\"txt\":\"2\"},\"dTimeS\":\"095100\",\"dTimeFS\":{\"styleX\":0},\"dProgType\":\"PROGNOSED\",\"dDirTxt\":\"Osloer Str.\",\"dDirFlg\":\"2\",\"type\":\"N\"},{\"