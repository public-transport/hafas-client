ame\":\"Tram 5\",\"nameS\":\"5\",\"number\":\"5\",\"icoX\":12,\"cls\":32,\"oprX\":0,\"prodCtx\":{\"name\":\"Tram 5  \",\"num\":\"17230\",\"line\":\"5\",\"lineId\":\"de:nvv:Tram|5:\",\"matchId\":\"5\",\"catOut\":\"Tram    \",\"catOutS\":\"T\",\"catOutL\":\"Straßenbahn\",\"catIn\":\"T\",\"catCode\":\"5\",\"admin\":\"KTR---\"},\"himIdL\":[\"HIM_FREETEXT_5582\"]},{\"pid\":\"L::5::Tram::B3736316743::de:nvv:Tram|6:::*\",\"name\":\"Tram 6\",\"nameS\":\"6\",\"number\":\"6\",\"icoX\":12,\"cls\":32,\"oprX\":0,\"prodCtx\":{\"name\":\"Tram 6  \",\"num\":\"17490\",\"line\":\"6\",\"lineId\":\"de:nvv:Tram|6:\",\"matchId\":\"6\",\"catOut\":\"Tram    \",\"catOutS\":\"T\",\"catOutL\":\"Straßenbahn\",\"catIn\":\"T\",\"catCode\":\"5\",\"admin\":\"KTR---\"}},{\"pid\":\"L::5::Tram::B3736316743::de:nvv:Tram|5:::*\",\"name\":\"Tram 5\",\"nameS\":\"5\",\"number\":\"5\",\"icoX\":12,\"cls\":32,\"oprX\":0,\"prodCtx\":{\"name\":\"Tram 5  \",\"num\":\"17231\",\"line\":\"5\",\"lineId\":\"de:nvv:Tram|5:\",\"matchId\":\"5\",\"catOut\":\"Tram    \",\"catOutS\":\"T\",\"catOutL\":\"Straßenbahn\",\"catIn\":\"T\",\"catCode\":\"5\",\"admin\":\"KTR---\"},\"himIdL\":[\"HIM_FREETEXT_5582\"]}],\"opL\":[{\"name\":\"KVG Tram\",\"icoX\":1,\"id\":\"711\"},{\"name\":\"BKW Bad Wildungen\",\"icoX\":7,\"id\":\"501\"},{\"name\":\"KVG Bus\",\"icoX\":9,\"id\":\"408\"}],\"remL\":[{\"type\":\"A\",\"code\":\"text.occup.loc.2nd.12\",\"icoX\":3,\"txtN\":\"Mittlere Belegung ab diesem Halt erwartet\"},{\"type\":\"A\",\"code\":\"text.occup.loc.max.12\",\"icoX\":3,\"txtN\":\"Hohe Belegung\"},{\"type\":\"A\",\"code\":\"CO\",\"prio\":2,\"icoX\":4,\"txtN\":\"Pflicht zum Tragen einer Mund-Nasen-Bedeckung! Infos: nvv.de/corona\"}],\"himL\":[{\"hid\":\"5149\",\"act\":true,\"head\":\"Sperrung zwischen Edertal-Wellen und Fritzlar ab 5. September 2022, Linie 500 fährt über Fritzlar-Ungedanken und Bad Wildungen-Mandern\",\"lead\":\"Vollsperrung zwischen Edertal-Wellen und Fritzlar, Linie 500 fährt über Fritzlar-Ungedanken und Bad Wildungen-Mandern.\",\"text\":\"Wegen der Vollsperrung der Landesstraße 3383 zwischen Wellen und Fritzlar kann die Linie 500 ab 05.09.2022 bis vsl. Mitte Dezember Wellen nicht bedienen.<br>Ebenfalls entfällt die Bedienung der Haltestelle Fritzlar Nordfeld in Richtung Wellen / aus Richtung Wellen und der Haltestelle Wega Mitte.<br>Der umleitungsbedingte Fahrweg führt über Mandern und Ungedanken. <br>Die Haltestellen dort werden bedient.<br>Fahrgäste aus Wellen nutzen bitte den stündlich verkehrenden AST der Linie 583.3 nach bzw. von Wega. <br>Diesen buchen sie bitte spätestens 30 Minuten vorher unter 05631-5062088.<br>Für die Schüler morgens in Richtung Fritzlar verkehrt ein Sonderbus um 7:00 Uhr ab Wellen Mitte, der an der Haltestelle Wega Ostlandsiedlung Anschluss an die reguläre Linie 500 nach Fritzlar hat.<br>Den geänderten Fahrplan der Linie 500 sowie den AST-Fahrplan der 583.3 finden sie im Internet unter www.nvv.de<br>Weitere Auskünfte erteilt auch das NVV-Servicetelefon<br><a href=\\\"https://nvv.hafas.cloud/him-uploads/1661839381234_220905_SI_Linie_500.pdf\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Sonderinformation Linie 500</a>\",\"tckr\":\"Vollsperrung zwische Wellen und Fritzlar ab 05.09.2022 bis vsl Mitte Dezember, Linie 500 fährt über Ungedanken und Mandern.\",\"icoX\":8,\"prio\":100,\"fLocX\":2,\"tLocX\":3,\"altStart\":\"\",\"altEnd\":\"\",\"prod\":192,\"src\":99,\"sDate\":\"20220905\",\"sTime\":\"000000\",\"eDate\":\"20221210\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"NVV Bus\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20220829\",\"fTime\":\"103100\",\"tDate\":\"20221210\",\"tTime\":\"235900\"}]}],\"icoL\":[{\"res\":\"prod_gen\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":193,\"g\":0,\"b\":31},\"shp\":\"R\",\"sty\":\"B\"},{\"res\":\"KVG\",\"txt\":\"KVG Tram\"},{\"res\":\"loc_stop\"},{\"res\":\"occup_fig_mid\"},{\"res\":\"attr_info\"},{\"bg\":{\"r\":193,\"g\":0,\"b\":31},\"shp\":\"C\"},{\"