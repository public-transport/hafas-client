\":\"Maskenpflicht nach gesetzl. Regelung; wir empfehlen eine FFP2-Maske\"},{\"type\":\"A\",\"code\":\"FR\",\"prio\":260,\"icoX\":4,\"txtN\":\"Fahrradmitnahme reservierungspflichtig\"},{\"type\":\"A\",\"code\":\"jk\",\"prio\":450,\"icoX\":3,\"txtN\":\"Bordrestaurant\"},{\"type\":\"A\",\"code\":\"jo\",\"prio\":560,\"icoX\":3,\"txtN\":\"Fahrzeuggebundene Einstiegshilfe vorhanden\"}],\"himL\":[{\"hid\":\"180442\",\"act\":true,\"head\":\"Achtung, Fahrplanwechsel - Fahrpläne noch nicht vollständig!\",\"text\":\"Für Auskünfte ab dem 11.12.2022 liegen zurzeit die Fahrpläne des Bahn-Regionalverkehrs sowie der Berliner S-Bahn, der Berliner Verkehrsbetriebe (BVG) und der meisten Verkehrsunternehmen in Brandenburg vor. Die restlichen Fahrpläne werden in den nächsten Wochen vervollständigt.<br><a href=\\\"https://www.vbb.de/zugumzug\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Informationen zu den Bahn-Änderungen zum Fahrplanwechsel</a>\",\"icoX\":5,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221211\",\"sTime\":\"000000\",\"eDate\":\"20230331\",\"eTime\":\"000000\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221103\",\"fTime\":\"195200\",\"tDate\":\"20230331\",\"tTime\":\"000000\"}],\"baseType\":\"GLOBAL\"},{\"hid\":\"181831\",\"act\":true,\"head\":\"Es gilt Maskenpflicht!\",\"text\":\"Bitte tragen Sie eine FFP2-Maske in den Fahrzeugen.<br><a href=\\\"https://www.vbb.de/corona\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Weitere Informationen</a>\",\"icoX\":5,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221116\",\"sTime\":\"072800\",\"eDate\":\"20231209\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221116\",\"fTime\":\"072800\",\"tDate\":\"20231209\",\"tTime\":\"235900\"}],\"baseType\":\"GLOBAL\"}],\"icoL\":[{\"res\":\"prod_ic\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\"