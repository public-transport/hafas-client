odL\":[{\"pid\":\"L::1::U::B3041857784::U_3041857784_U9::*\",\"name\":\"U9\",\"nameS\":\"U9\",\"number\":\"U9\",\"icoX\":0,\"cls\":2,\"oprX\":0,\"prodCtx\":{\"name\":\"      U9\",\"num\":\"5678\",\"line\":\"U9\",\"matchId\":\"U9\",\"catOut\":\"U       \",\"catOutS\":\"U\",\"catOutL\":\"U       \",\"catIn\":\"U\",\"catCode\":\"1\",\"admin\":\"BVU---\"},\"himIdL\":[\"HIM_FREETEXT_76247\",\"HIM_FREETEXT_84585\"]}],\"opL\":[{\"name\":\"Berliner Verkehrsbetriebe\",\"url\":\"https://www.bvg.de/\",\"icoX\":1,\"id\":\"796\"}],\"remL\":[{\"type\":\"A\",\"code\":\"OPERATOR\",\"icoX\":3,\"txtS\":\"BVG\",\"txtN\":\"BVG\",\"txtL\":\"Berliner Verkehrsbetriebe\"},{\"type\":\"A\",\"code\":\"bf\",\"prio\":2,\"icoX\":3,\"txtN\":\"barrierefrei\"},{\"type\":\"A\",\"code\":\"FB\",\"prio\":10,\"icoX\":4,\"txtN\":\"Fahrradmitnahme möglich\"}],\"himL\":[{\"hid\":\"76247\",\"act\":true,\"head\":\"Aufzugsstörung\",\"text\":\"Wegen einer Baumaßnahme ist der Bahnhof geschlossen. Daher fährt der Aufzug im Bahnhof U Kurfürstendamm (Straße &lt; > Bahnsteig U1 Richtung Warschauer Straße) erst ab 23.12.2022 wieder. (gilt für: U Kurfürstendamm (Berlin))\",\"icoX\":5,\"prio\":100,\"fLocX\":9,\"prod\":61442,\"src\":99,\"lModDate\":\"20220815\",\"lModTime\":\"092608\",\"sDate\":\"20220815\",\"sTime\":\"012400\",\"eDate\":\"20221223\",\"eTime\":\"070000\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"timetable\",\"fDate\":\"20220815\",\"fTime\":\"012400\",\"tDate\":\"20221223\",\"tTime\":\"070000\"}]},{\"hid\":\"180442\",\"act\":true,\"head\":\"Achtung, Fahrplanwechsel - Fahrpläne noch nicht vollständig!\",\"text\":\"Für Auskünfte ab dem 11.12.2022 liegen zurzeit die Fahrpläne des Bahn-Regionalverkehrs sowie der Berliner S-Bahn, der Berliner Verkehrsbetriebe (BVG) und der meisten Verkehrsunternehmen in Brandenburg vor. Die restlichen Fahrpläne werden in den nächsten Wochen vervollständigt.<br><a href=\\\"https://www.vbb.de/zugumzug\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Informationen zu den Bahn-Änderungen zum Fahrplanwechsel</a>\",\"icoX\":6,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221211\",\"sTime\":\"000000\",\"eDate\":\"20230331\",\"eTime\":\"000000\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[1],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221103\",\"fTime\":\"195200\",\"tDate\":\"20230331\",\"tTime\":\"000000\"}],\"baseType\":\"GLOBAL\"},{\"hid\":\"181831\",\"act\":true,\"head\":\"Es gilt Maskenpflicht!\",\"text\":\"Bitte tragen Sie eine FFP2-Maske in den Fahrzeugen.<br><a href=\\\"https://www.vbb.de/corona\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Weitere Informationen</a>\",\"icoX\":6,\"prio\":100,\"prod\":65535,\"src\":50,\"sDate\":\"20221116\",\"sTime\":\"072800\",\"eDate\":\"20231209\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"VBB\",\"catRefL\":[1],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20221116\",\"fTime\":\"072800\",\"tDate\":\"20231209\",\"tTime\":\"235900\"}],\"baseType\":\"GLOBAL\"}],\"icoL\":[{\"res\":\"prod_sub_t\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"res\":\"BVG\",\"txt\":\"Berliner Verkehrsbetriebe\"},{\"res\":\"loc_stop\"},{\"res\":\"attr_info\"},{\"res\":\"attr_bike_r\"},{\"res\":\"HIM3\"},{\"res\":\"HIM0\"}],\"himMsgCatL\":[{\"id\":3},{\"id\":0}],\"dirL\":[{\"txt\":\"Osloer Str.\",\"flg\":\"2\"}],\"lDrawStyleL\":[{\"sIcoX\":0,\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}},{\"type\":\"SOLID\",\"bg\":{\"r\":0,\"g\":101,\"b\":173}}],\"timeStyleL\":[{\"mode\":\"ABS\"}]},\"journey\":{\"jid\":\"1|45958|5|86|19122022\",\"date\":\"20221219\",\"prodX\":0,\"dirTxt\":\"Osloer Str.\",\"dirFlg\":\"2\",\"status\":\"P\",\"isRchbl\":true,\"stopL\":[{\"locX\":0,\"idx\":0,\"dProdX\":0,\"dPltfS\":{\"type\":\"PL\",\"txt\":\"2\"},\"dTimeS\":\"095900\",\"dTimeFS\":{\"styleX\":0},\"dProgType\":\"PROGNOSED\",\"dDirTxt\":\"Osloer Str.\",\"dDirFlg\":\"2\",\"type\":\"N\"},{\"l