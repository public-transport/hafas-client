:B1049474481::de:nvv:Bus|500:::*\",\"name\":\"Bus 500\",\"nameS\":\"500\",\"number\":\"500\",\"icoX\":10,\"cls\":64,\"oprX\":1,\"prodCtx\":{\"name\":\"Bus 500 \",\"num\":\"585\",\"line\":\"500\",\"lineId\":\"de:nvv:Bus|500:\",\"matchId\":\"500020\",\"catOut\":\"Bus     \",\"catOutS\":\"NF\",\"catOutL\":\"Niederflurbus\",\"catIn\":\"NF\",\"catCode\":\"6\",\"admin\":\"BKW_BW\"},\"himIdL\":[\"HIM_FREETEXT_5149\"]}],\"opL\":[{\"name\":\"KVG Tram\",\"icoX\":1,\"id\":\"711\"},{\"name\":\"BKW Bad Wildungen\",\"icoX\":11,\"id\":\"501\"}],\"remL\":[{\"type\":\"A\",\"code\":\"text.occup.loc.2nd.12\",\"icoX\":3,\"txtN\":\"Mittlere Belegung ab diesem Halt erwartet\"},{\"type\":\"A\",\"code\":\"text.occup.loc.max.12\",\"icoX\":3,\"txtN\":\"Hohe Belegung\"},{\"type\":\"A\",\"code\":\"CO\",\"prio\":2,\"icoX\":4,\"txtN\":\"Pflicht zum Tragen einer Mund-Nasen-Bedeckung! Infos: nvv.de/corona\"},{\"type\":\"A\",\"code\":\"text.occup.loc.2nd.11\",\"icoX\":5,\"txtN\":\"Geringe Belegung ab diesem Halt erwartet\"},{\"type\":\"A\",\"code\":\"text.occup.loc.max.11\",\"icoX\":5,\"txtN\":\"Geringe Belegung\"}],\"himL\":[{\"hid\":\"5149\",\"act\":true,\"head\":\"Sperrung zwischen Edertal-Wellen und Fritzlar ab 5. September 2022, Linie 500 fährt über Fritzlar-Ungedanken und Bad Wildungen-Mandern\",\"lead\":\"Vollsperrung zwischen Edertal-Wellen und Fritzlar, Linie 500 fährt über Fritzlar-Ungedanken und Bad Wildungen-Mandern.\",\"text\":\"Wegen der Vollsperrung der Landesstraße 3383 zwischen Wellen und Fritzlar kann die Linie 500 ab 05.09.2022 bis vsl. Mitte Dezember Wellen nicht bedienen.<br>Ebenfalls entfällt die Bedienung der Haltestelle Fritzlar Nordfeld in Richtung Wellen / aus Richtung Wellen und der Haltestelle Wega Mitte.<br>Der umleitungsbedingte Fahrweg führt über Mandern und Ungedanken. <br>Die Haltestellen dort werden bedient.<br>Fahrgäste aus Wellen nutzen bitte den stündlich verkehrenden AST der Linie 583.3 nach bzw. von Wega. <br>Diesen buchen sie bitte spätestens 30 Minuten vorher unter 05631-5062088.<br>Für die Schüler morgens in Richtung Fritzlar verkehrt ein Sonderbus um 7:00 Uhr ab Wellen Mitte, der an der Haltestelle Wega Ostlandsiedlung Anschluss an die reguläre Linie 500 nach Fritzlar hat.<br>Den geänderten Fahrplan der Linie 500 sowie den AST-Fahrplan der 583.3 finden sie im Internet unter www.nvv.de<br>Weitere Auskünfte erteilt auch das NVV-Servicetelefon<br><a href=\\\"https://nvv.hafas.cloud/him-uploads/1661839381234_220905_SI_Linie_500.pdf\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Sonderinformation Linie 500</a>\",\"tckr\":\"Vollsperrung zwische Wellen und Fritzlar ab 05.09.2022 bis vsl Mitte Dezember, Linie 500 fährt über Ungedanken und Mandern.\",\"icoX\":12,\"prio\":100,\"fLocX\":3,\"tLocX\":4,\"altStart\":\"\",\"altEnd\":\"\",\"prod\":192,\"src\":99,\"sDate\":\"20220905\",\"sTime\":\"000000\",\"eDate\":\"20221210\",\"eTime\":\"235900\",\"sDaily\":\"000000\",\"eDaily\":\"235900\",\"comp\":\"NVV Bus\",\"catRefL\":[0],\"pubChL\":[{\"name\":\"TIMETABLE\",\"fDate\":\"20220829\",\"fTime\":\"103100\",\"tDate\":\"20221210\",\"tTime\":\"235900\"}]}],\"icoL\":[{\"res\":\"prod_gen\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":193,\"g\":0,\"b\":31},\"shp\":\"R\",\"sty\":\"B\"},{\"res\":\"KVG\",\"txt\":\"KVG Tram\"},{\"res\":\"loc_stop\"},{\"res\":\"occup_fig_mid\"},{\"res\":\"attr_info\"},{\"res\":\"occup_fig_low\"},{\"res\":\"POI_MUSEUM\"},{\"res\":\"prod_walk\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":245,\"g\":167,\"b\":5},\"shp\":\"C\",\"sty\":\"B\"},{\"bg\":{\"r\":193,\"g\":0,\"b\":31},\"shp\":\"C\"},{\"bg\":{\"r\":245,\"g\":167,\"b\":5},\"shp\":\"C\"},{\"res\":\"prod_bus_t\",\"fg\":{\"r\":255,\"g\":255,\"b\":255},\"bg\":{\"r\":117,\"g\":22,\"b\":115},\"shp\":\"C\",\"sty\":\"B\"},{\"res\":\"BKW\",\"txt\":\"BKW Bad Wildungen\"},{\"res\":\"HIM1\"},{\"bg\":{\"r\":117,\"g\":22,\"b\":115},\"shp\":\"C\"},{\"res\":\"pt_foot\"},{\"res\":\"pt_bike\"},{\"res\":\"cl_foot\"}],\"tcocL\":[{\"c\":\"SECOND\",\"r\":12},{\"